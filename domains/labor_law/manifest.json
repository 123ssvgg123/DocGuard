      "label": "人事流程规范库",
      "file_prefix": "HR-SOP",
      "access_level": "internal",
      "department": "hr",
      "separators": ["\n## ", "\n### ", "\n[0-9]{1,2}\\．", "\n\n", "\n", "。|！|？"],
      "child_chunk_size": null
    },
    {
      "id": "case",
