{
  "domain_id": "labor_law",
  "display_name": "劳动用工合规",
  "version": "1.0.0",
  "status": "cross_validation",
  "description": "跨领域验证包：用与食品安全完全无关的第二套语料（劳动合同法 / 离职 SOP / 竞业限制案例 / 外包合同 / 用工 FAQ），跑同一套「建库 → 切分 → 召回 → 精排 → 阈值拒答 → 引用溯源」链路。目的不是做一个人力资源产品，而是证明这条链路与领域解耦：换语料即可复用，运行时、检索、拒答、留痕、权限一行不改。",
  "corpus_dir": "domains/labor_law/corpus",
  "kb_types": [
    {
      "id": "regulation",
      "label": "劳动法律法规库",
      "file_prefix": "LAW",
      "access_level": "public",
      "department": "general",
      "separators": ["\n## ", "\n### ", "\n第[一二三四五六七八九十百零]{1,4}条", "\n\n", "\n", "。|！|？"],
      "child_chunk_size": null
    },
    {
