# ===== 应用 =====
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== Milvus 向量库 =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE_NAME=default
MILVUS_COLLECTION_NAME=food_safety

# ===== 大模型（DeepSeek / 兼容 OpenAI 协议）=====
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_API_KEY_NAME=tool
LLM_BASE_URL=https://api.deepseek.com/v1

# ===== 本地向量与精排模型 =====
EMBEDDING_MODEL=./models/embedding/bge-m3
RERANK_MODEL=./models/reranker/bge-reranker-large
